# ── Secrets ─────────────────────────────
.env
*.pem
*.key
secrets/
credentials.json

# ── Python ─────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ── Databases / broker data ────────────
*.db
*.db-journal
*.sqlite3
dump.rdb

# ── Logs / media / backups ─────────────
logs/
*.log
media_uploads/
backups/

# ── IDE / OS ───────────────────────────
.idea/
.vscode/
.DS_Store
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ── Node (miniapp) ─────────────────────
miniapp/node_modules/
# miniapp/dist is a BUILT ARTIFACT for the Vercel SPA static build; it must be
# uploaded on deploy (legacy builds). Re-include despite the global `dist/`.
!miniapp/dist/
!miniapp/dist/**

# Node for the OpenClaw bridge plugin (keep its built dist/)
openclaw/gramma-bridge/node_modules/
!openclaw/gramma-bridge/dist/
!openclaw/gramma-bridge/dist/**

# Vercel local link state (contains project/org ids — not secrets, but noisy)
.vercel/
.vercel
