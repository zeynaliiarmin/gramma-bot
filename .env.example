# ==================================================================
#  Gramma v3 — environment configuration template
#  cp .env.example .env  and fill values. Never commit .env.
# ==================================================================

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN="PASTE_BOT_TOKEN_HERE"
TELEGRAM_BOT_USERNAME="your_bot"
ADMIN_TELEGRAM_IDS=""            # comma-separated numeric ids

# ── Meta / Instagram Graph API ────────────────────────────────
INSTAGRAM_ACCOUNT_MODE="simulation"   # simulation | production
META_APP_ID=""
META_APP_SECRET=""                    # plaintext or enc:<base64>
META_VERIFY_TOKEN="random-verify-token"
WEBHOOK_BASE_URL="https://your-domain.example"
GRAPH_API_VERSION="v21.0"

# ── Database / Redis / Scheduler ──────────────────────────────
DATABASE_URL="sqlite+aiosqlite:///./gramma.db"
REDIS_URL="redis://localhost:6379/0"
SCHEDULER_BACKEND="auto"              # auto | celery | inprocess

# ── Encryption (AES-256) ──────────────────────────────────────
# Generate: python scripts/generate_cipher_key.py
ENCRYPTION_KEY="REPLACE_WITH_BASE64_32BYTE_KEY"

# ── AI (AvalAI — OpenAI-compatible) / Web search (Tavily) ─────
AVALAI_API_KEY=""
AVALAI_BASE_URL="https://api.avalai.ir/v1"
AVALAI_MODEL="gpt-4o-mini"
TAVILY_API_KEY=""

# ── Limits & superpowers ──────────────────────────────────────
MAX_ACCOUNTS_PER_USER="3"             # 3 pages per user
MAX_TOTAL_ACCOUNTS_DEV="24"           # 24 pages total (dev mode)
AUTO_BACKUP_ENABLED="true"
AUTO_BACKUP_HOUR="4"
BACKUP_DIR="backups"
SEMANTIC_SEARCH_ENABLED="true"
SMART_NOTIFICATIONS_ENABLED="true"
PUBLIC_BASE_URL=""

# ── Optional: media CDN (S3-compatible) ───────────────────────
S3_BUCKET=""
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_PUBLIC_BASE=""

LOG_LEVEL="INFO"
DATA_RETENTION_DAYS="90"
